# ─── LLM Provider ──────────────────────────────────────────────────────────────
# Set to "huggingface" to enable AI-generated counselor responses
LLM_PROVIDER=huggingface

# Required for HuggingFace: get your free token at https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Which model to use (free with HuggingFace Inference API)
HUGGINGFACE_MODEL=mistralai/Mistral-7B-Instruct-v0.2

# ─── Optional: OpenAI instead of HuggingFace ───────────────────────────────────
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── Render Keep-Alive ─────────────────────────────────────────────────────────
# Set this to your Render app URL after deployment to prevent free tier sleep
RENDER_URL=https://placidus-ai.onrender.com
KEEP_ALIVE_INTERVAL_MINUTES=14

# ─── RAG Knowledge Store ───────────────────────────────────────────────────────
VECTORSTORE_PATH=data/vectorstore
